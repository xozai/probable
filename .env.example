# Neon in production; any Postgres 13+ works locally (gen_random_uuid()
# requires no extension from 13 on).
DATABASE_URL=postgres://probable:probable@localhost:5432/probable

# Auth.js / Resend. Generate AUTH_SECRET with `npx auth secret`.
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_ALLOWED_EMAILS=owner@example.com
AUTH_RESEND_KEY=re_replace_with_resend_api_key
AUTH_EMAIL_FROM=Probable <auth@example.com>
